<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>epos4_ros2_control</name>
  <version>0.1.0</version>
  <description>
    hardware_interface::SystemInterface plugin exposing N EPOS4 axes to
    ros2_control on top of epos4_driver.
  </description>
  <maintainer email="cabreratrejoimadjared@gmail.com">Imad Jared Cabrera Trejo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The base class the plugin derives from -->
  <depend>hardware_interface</depend>
  <!-- Loads the plugin class by name at run time (dlopen) -->
  <depend>pluginlib</depend>
  <!-- rclcpp_lifecycle: SystemInterface returns lifecycle return types -->
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <!-- Our own library. The arrow points this way and only this way. -->
  <depend>epos4_driver</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- PHASE 4: pluginlib needs this export to find the class. Without it
         the build succeeds but it fails at run time with "class not found".
    <hardware_interface plugin="${prefix}/epos4_ros2_control_plugin.xml"/>
    -->
  </export>
</package>
