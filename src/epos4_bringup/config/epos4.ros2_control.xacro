<?xml version="1.0"?>
<!-- ======================================================================
     ros2_control macros for maxon EPOS4 drives on one CAN bus.

     Two macros, so that this file knows nothing about any particular arm:

       epos4_system   the <ros2_control> block: one CAN bus, one master DCF.
                      The joints go inside it as its block parameter.
       epos4_joint    one axis: its node-ID and the mechanism that turns
                      encoder counts into joint radians.

     All joint values are in RADIANS at the joint, as ros2_control expects.
     The plugin converts to encoder quadcounts from quadcounts_per_revolution
     and gear_ratio.

     master_dcf must be the one generated from the bus.yml whose node-IDs the
     joints use, and it has to be an absolute path: Lely resolves the
     UploadFile entries inside it at boot, not at load. epos4_sim runs on the
     SAME network as the hardware (epos4_network); sim_network is only for the
     canopen_fake_slaves mock, and against epos4_sim its boot aborts with
     es='D' before the PDO mapping is downloaded.
     ====================================================================== -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="epos4_system"
               params="name master_dcf can_interface:=can0 master_node_id:=1 **joints">
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>epos4_ros2_control/Epos4System</plugin>
        <param name="can_interface">${can_interface}</param>
        <param name="master_dcf">${master_dcf}</param>
        <param name="master_node_id">${master_node_id}</param>
      </hardware>
      <xacro:insert_block name="joints"/>
    </ros2_control>
  </xacro:macro>

  <!-- quadcounts_per_revolution is FOUR TIMES the encoder's pulses per
       revolution: a 500 CPR encoder is 2000. gear_ratio is output over
       motor: a 1:100 reduction is 0.01.

       The command interface is position only, and the plugin rejects any
       other: it drives Cyclic Synchronous Position, where the trajectory is
       generated by the controller and the drive interpolates between
       setpoints. -->
  <xacro:macro name="epos4_joint"
               params="name node_id quadcounts_per_revolution gear_ratio:=1.0">
    <joint name="${name}">
      <param name="node_id">${node_id}</param>
      <param name="quadcounts_per_revolution">${quadcounts_per_revolution}</param>
      <param name="gear_ratio">${gear_ratio}</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

</robot>
