<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>epos4_driver</name>
  <version>0.1.0</version>
  <description>
    C++ library for maxon EPOS4 motion controllers over CANopen
    (CiA 301 / CiA 402). ROS independent: depends only on Lely CANopen.
  </description>
  <maintainer email="cabreratrejoimadjared@gmail.com">Imad Jared Cabrera Trejo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The only dependency of this package. If rclcpp, hardware_interface or
       epos4_interfaces ever show up here, the architecture has been broken. -->
  <depend>lely_core_libraries</depend>

  <test_depend>ament_cmake_uncrustify</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
